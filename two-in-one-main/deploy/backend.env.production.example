# =============================================================================
# Production environment for the two-in-one backend (no real secrets here).
#
# On the VPS, create twoinone-backend-main/.env and paste the REAL values:
#   - MONGO_URI  : copy it from the current twoinone-backend-main/.env
#                  (Atlas cluster0.djwdzz9.mongodb.net/twoinone — verified reachable,
#                  all collections still contain the production data)
#   - JWT_SECRET : copy it from the current .env — MUST stay the same so the
#                  frontend's stored admin tokens keep validating.
#
# NEVER commit the real .env. This file is only a key template.
# =============================================================================

# Port the Node app listens on internally (nginx proxies 443 -> this port).
PORT=5001

NODE_ENV=production

# Browser origin allowed to call the API (single origin — the backend passes it
# straight to the cors package; see src/server.js). If you also want to call the
# production API from a local dev server, add a second value in code or
# temporarily set this to http://localhost:5173.
CLIENT_URL=https://physiocare-letsplayzone.com

# --- REAL values to copy from twoinone-backend-main/.env (do not commit) ----
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.djwdzz9.mongodb.net/twoinone?retryWrites=true&w=majority
JWT_SECRET=<same secret as before>
